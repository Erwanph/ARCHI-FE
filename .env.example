# Inquiry email (Resend, https://resend.com). Required on Vercel, where there
# is no D1 database: every inquiry is emailed to the team instead.
RESEND_API_KEY=
# Optional: recipient(s), comma-separated. Default: kenzie.revano@archi.com
INQUIRY_EMAIL_TO=
# Optional: sender on a domain verified in Resend, e.g.
# ARCHI Website <inquiries@your-domain>. Default: onboarding@resend.dev, which
# Resend only delivers to the email address of the Resend account owner.
INQUIRY_EMAIL_FROM=

# Optional HTTPS endpoint that receives a metadata-only inquiry-created event.
INQUIRY_NOTIFICATION_WEBHOOK_URL=

# Optional bearer token used only with the configured webhook endpoint.
INQUIRY_NOTIFICATION_WEBHOOK_TOKEN=

# Nusa, the website assistant. Fill ONE key; leave both empty to run Nusa in
# "quick answers" mode, which replies from verified site copy only.

# OpenRouter key (https://openrouter.ai/keys). Uses free models; takes priority.
OPENROUTER_API_KEY=
# Optional: comma-separated models, tried in order. Leave empty for the default
# free list (MiniMax M3.1 Flash, Gemma 4 31B, Gemma 4 26B, Nemotron 3 Super, openrouter/free).
OPENROUTER_MODELS=

# Anthropic key, used only when OPENROUTER_API_KEY is empty.
ANTHROPIC_API_KEY=
